# ==========================================
# Barcelona Internship Discovery Bot - Environment Config
# ==========================================

# Database configuration (PostgreSQL 16 with pgvector extension)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/bcn_internships"

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
ALLOWED_TELEGRAM_IDS="123456789,987654321"
TELEGRAM_ADMIN_CHAT_ID="123456789"

# AI / LLM Layer (OpenCode & OpenAI)
OPENCODE_API_KEY="your_opencode_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"

# Runtime & Logging
NODE_ENV="development"
LOG_LEVEL="debug"

# ==========================================
# JobFinder - Environment Config
# ==========================================

# Database configuration (PostgreSQL 16 with pgvector extension)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/bcn_internships"

# Telegram Bot Integration (JobFinder)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
ALLOWED_TELEGRAM_IDS="123456789,987654321"
TELEGRAM_ADMIN_CHAT_ID="123456789"

# Paseo bridge (AGY)
AGY_BIN="agy"
PASEO_AGY_TIMEOUT_MS="300000"
# Keep sandboxing enabled for normal JobFinder users.
PASEO_AGY_SANDBOX="true"
# Set true only for an explicitly trusted/admin-only deployment.
PASEO_AGY_SKIP_PERMISSIONS="false"

# Local ats-scrapers workspace and optional global query scope.
ATS_SCRAPER_ROOT="/Users/cadowo/Library/Mobile Documents/com~apple~CloudDocs/Documents/projects/vibes/ats_scraper"
ATS_SCRAPER_LOCATION=""
ATS_SCRAPER_REMOTE_ONLY="false"
# Use one hosted source per crawl; empty loads the full dataset (very large).
ATS_SCRAPER_ATS="greenhouse"

# Runtime & Logging
NODE_ENV="development"
LOG_LEVEL="debug"
